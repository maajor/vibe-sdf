function map(p) {
  const walls = roundedBox(p - vec3(0, -0.4, 0), vec3(1.1, 0.9, 0.9), 0.06, { color: [0.94, 0.87, 0.78] });
  const foundation = roundedBox(p - vec3(0, -1.05, 0), vec3(1.15, 0.15, 0.95), 0.04, { color: [0.6, 0.6, 0.58] });

  const roofA = roundedBox(rotateZ(p - vec3(0.4, 0.75, 0), PI / 9), vec3(0.7, 0.18, 1.05), 0.06, { color: [0.48, 0.08, 0.06] });
  const roofB = roundedBox(rotateZ(p - vec3(-0.4, 0.75, 0), -PI / 9), vec3(0.7, 0.18, 1.05), 0.06, { color: [0.48, 0.08, 0.06] });
  const roofRidge = roundedBox(rotateY(p - vec3(0, 1.2, 0), -PI / 2), vec3(1.1, 0.1, 0.15), 0.1, { color: [0.42, 0.06, 0.05] });
  const roofPanels = union(roofA, union(roofB, roofRidge, 0.22), 0.22);

  const chimneySolid = roundedBox(p - vec3(0.6, 1.05, -0.25), vec3(0.13, 0.45, 0.12), 0.02, { color: [0.65, 0.22, 0.18] });
  const chimneyTopCut = box(p - vec3(0.6, 1.28, -0.25), vec3(0.11, 0.03, 0.11));
  const chimney = subtract(chimneySolid, chimneyTopCut);

  const houseShell = union(union(walls, foundation, 0.18), union(roofPanels, chimney, 0.18), 0.22);

  const doorCut = box(p - vec3(0, -0.6, 0.96), vec3(0.30, 0.48, 0.16));
  const windowCutL = box(p - vec3(-0.62, -0.12, 0.96), vec3(0.26, 0.22, 0.14));
  const windowCutR = box(p - vec3(0.62, -0.12, 0.96), vec3(0.26, 0.22, 0.14));
  const gableWindowCut = sphere(p - vec3(0, 1.05, 0), 0.14);

  const openings = union(union(doorCut, windowCutL, 0.12), union(windowCutR, gableWindowCut, 0.12), 0.12);
  const hollowHouse = subtract(houseShell, openings);

  const doorWood = roundedBox(p - vec3(0, -0.7, 0.84), vec3(0.26, 0.44, 0.035), 0.02, { color: [0.36, 0.22, 0.12] });
  const doorHandle = sphere(p - vec3(0.12, -0.68, 0.78), 0.03, { color: [0.95, 0.82, 0.24] });

  const glassL = roundedBox(p - vec3(-0.62, -0.12, 0.84), vec3(0.22, 0.18, 0.03), 0.01, { color: [0.2, 0.5, 0.7] });
  const glassR = roundedBox(p - vec3(0.62, -0.12, 0.84), vec3(0.22, 0.18, 0.03), 0.01, { color: [0.2, 0.5, 0.7] });
  const gableGlass = sphere(p - vec3(0, 1.05, 0), 0.11, { color: [0.24, 0.52, 0.72] });

  const frameMidL = box(p - vec3(-0.62, -0.12, 0.85), vec3(0.02, 0.17, 0.04), { color: [0.85, 0.8, 0.72] });
  const frameCrossL = box(p - vec3(-0.62, -0.12, 0.85), vec3(0.22, 0.02, 0.04), { color: [0.85, 0.8, 0.72] });
  const frameMidR = box(p - vec3(0.62, -0.12, 0.85), vec3(0.02, 0.17, 0.04), { color: [0.85, 0.8, 0.72] });
  const frameCrossR = box(p - vec3(0.62, -0.12, 0.85), vec3(0.22, 0.02, 0.04), { color: [0.85, 0.8, 0.72] });

  const porch = roundedBox(p - vec3(0, -1.05, 0.96), vec3(0.48, 0.09, 0.38), 0.04, { color: [0.45, 0.36, 0.28] });
  const step = roundedBox(p - vec3(0, -1.25, 1.06), vec3(0.34, 0.06, 0.22), 0.03, { color: [0.4, 0.34, 0.28] });

  const windowsUnion = union(union(union(glassL, union(frameMidL, frameCrossL, 0.05), 0.05), union(glassR, union(frameMidR, frameCrossR, 0.05), 0.05), 0.05), gableGlass, 0.05);
  const doorsAndDetails = union(doorWood, doorHandle, 0.05);
  const porchGroup = union(porch, step, 0.08);

  return union(hollowHouse, union(union(windowsUnion, doorsAndDetails, 0.06), porchGroup, 0.06), 0.12);
}